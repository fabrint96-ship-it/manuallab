# ============================================================
# ManualLab — Environment Variables
# ============================================================
#
# Copy this file to `.env` for local development.
#
# Never commit real secrets.
# Variables prefixed with VITE_ are exposed to the browser.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NODE_ENV=development

API_HOST=127.0.0.1
API_PORT=3000
# Render injects PORT automatically in production.
PORT=

WEB_URL=http://localhost:5173
API_URL=http://localhost:3000


# ------------------------------------------------------------
# Supabase — Public
# ------------------------------------------------------------
#
# These values may be used by the frontend.
# Never place service-role or database credentials here.
#

VITE_SUPABASE_URL=http://127.0.0.1:55121
VITE_SUPABASE_PUBLISHABLE_KEY=your_local_publishable_key


# ------------------------------------------------------------
# Supabase — Backend
# ------------------------------------------------------------

SUPABASE_URL=http://127.0.0.1:55121
SUPABASE_PUBLISHABLE_KEY=your_local_publishable_key

# Server-only privileged credential.
SUPABASE_SECRET_KEY=your_local_secret_key


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55122/postgres


# ------------------------------------------------------------
# AI providers
# ------------------------------------------------------------
#
# Providers will be configured in EP-05.
#

OPENAI_API_KEY=


# ------------------------------------------------------------
# Render
# ------------------------------------------------------------
#
# Production values are configured in Render.
# Do not store production secrets in this repository.
#