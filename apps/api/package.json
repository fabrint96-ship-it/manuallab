{
  "name": "@manuallab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ManualLab API application.",
  "scripts": {
    "dev": "pnpm --filter @manuallab/database... build && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm --filter @manuallab/database... build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @manuallab/database... build && pnpm --dir ../.. exec vitest run --config vitest.config.mts apps/api/src",
    "test:watch": "pnpm --filter @manuallab/database... build && pnpm --dir ../.. exec vitest --config vitest.config.mts apps/api/src",
    "test:integration": "pnpm --filter @manuallab/database... build && tsx tests/project-persistence.integration.ts"
  },
  "dependencies": {
    "@manuallab/database": "workspace:*",
    "@manuallab/shared": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12"
  }
}
